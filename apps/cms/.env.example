DATABASE_URI=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PAYLOAD_SECRET=YOUR_SECRET_HERE_MIN_32_CHARS
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
WEBHOOK_SECRET=replace-me
YOUTUBE_WEBHOOK_SECRET=replace-me
LINKAUTOWORK_GATEWAY_URL=https://autowork-gateway.example.com/events
LINKAUTOWORK_SIGNING_SECRET=replace-me
LINKAUTOWORK_SIGNING_KEY_ID=linksites-dev
LINKAUTOWORK_ENVIRONMENT=development
LINKAUTOWORK_OUTBOX_PATH=.local/linkautowork-outbox.json
LINKAUTOWORK_EVENT_GRANTS=[{"eventName":"demo.completed","environments":["development"],"orgIds":["org_demo"]}]
REBUILD_WEBHOOK_URL=https://vercel.example.com/api/rebuild
REBUILD_STALE_DAYS=7
SEARCH_INDEX_ENDPOINT=https://search.example.com/index
PAYLOAD_CACHE_TTL_MS=600000
PAYLOAD_CACHE_CAPACITY=200
DRAFT_MAX_AGE_DAYS=30
