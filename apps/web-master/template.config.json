{
  "template": "company-site",
  "designSystemVersion": "v1",
  "navigation": {
    "primary": [
      { "labelDocId": "nav-services", "slug": "/services" },
      { "labelDocId": "nav-products", "slug": "/products" },
      { "labelDocId": "nav-offers", "slug": "/offers" },
      { "labelDocId": "nav-resources", "slug": "/resources" },
      { "labelDocId": "nav-about", "slug": "/about" },
      { "labelDocId": "nav-contact", "slug": "/contact" }
    ],
    "cta": { "labelDocId": "nav-cta", "slug": "/contact" }
  },
  "legal": {
    "privacy": "legal-privacy",
    "terms": "legal-terms",
    "cookies": "legal-cookies",
    "gdpr": "legal-gdpr",
    "disclaimer": "legal-disclaimer"
  },
  "pages": {
    "/": {
      "layout": "a1-linear",
      "slots": {
        "title": { "title": "home-title", "subtitle": "home-subtitle" },
        "services": { "collectionDocId": "home-services-collection" },
        "products": { "collectionDocId": "home-products-collection" },
        "proof": { "collectionDocId": "home-proof-collection" }
      }
    },
    "/offers/[offerSlug]": {
      "layout": "offer-page",
      "slots": {
        "summary": { "title": "offer-title", "body": "offer-body" },
        "features": { "collectionDocId": "offer-features" },
        "pricing": { "collectionDocId": "offer-pricing" },
        "testimonials": { "collectionDocId": "offer-testimonials" },
        "relatedResources": { "collectionDocId": "offer-related-resources" }
      }
    },
    "/products/[productSlug]": {
      "layout": "product-page",
      "slots": {
        "summary": { "title": "product-title", "body": "product-body" },
        "features": { "collectionDocId": "product-features" },
        "specifications": { "collectionDocId": "product-specs" },
        "pricing": { "collectionDocId": "product-pricing" }
      }
    },
    "/services/[serviceSlug]": {
      "layout": "service-page",
      "slots": {
        "summary": { "title": "service-title", "body": "service-body" },
        "features": { "collectionDocId": "service-features" },
        "pricing": { "collectionDocId": "service-pricing" }
      }
    },
    "/team/[memberSlug]": {
      "layout": "team-detail",
      "slots": {
        "person": { "title": "team-name", "role": "team-role", "body": "team-bio" }
      }
    },
    "/locations/[locationSlug]": {
      "layout": "location-detail",
      "slots": {
        "details": { "title": "location-name", "body": "location-address" },
        "hours": { "collectionDocId": "location-hours" }
      }
    },
    "/resources/[articleSlug]": {
      "layout": "article",
      "slots": {
        "title": { "title": "article-title", "excerpt": "article-excerpt" },
        "body": { "contentDocId": "article-body" },
        "related": { "collectionDocId": "article-related" }
      }
    },
    "/videos/[videoSlug]": {
      "layout": "video",
      "slots": {
        "title": { "title": "video-title", "excerpt": "video-excerpt" },
        "body": { "contentDocId": "video-body" },
        "relatedVideos": { "collectionDocId": "video-related" },
        "relatedArticles": { "collectionDocId": "video-related-articles" }
      }
    },
    "/about": {
      "layout": "about-index",
      "slots": {
        "story": { "title": "about-title", "body": "about-body" },
        "sections": { "collectionDocId": "about-sections" }
      }
    },
    "/contact": {
      "layout": "contact",
      "slots": {
        "title": { "title": "contact-title", "subtitle": "contact-subtitle" },
        "form": { "formDocId": "contact-form-def" },
        "map": { "coordinatesDocId": "contact-coordinates" },
        "cta": { "label": "contact-cta-label", "url": "/contact" }
      }
    },
    "/legal/[legalSlug]": {
      "layout": "legal",
      "slots": {
        "body": { "contentDocId": "legal-body" }
      }
    }
  }
}
