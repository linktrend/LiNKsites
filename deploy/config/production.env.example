# This is a name-only production reference. Do not place values, credentials,
# host-specific DNS details, or private tokens in this file. Populate a
# protected runtime environment file outside Git and validate it before use.
LINKSITES_DEPLOYMENT_ENV=production
LINKSITES_CONFIG_SCHEMA_VERSION=1.1.0
LINKSITES_RELEASE_SHA=<full-40-character-git-sha>
LINKSITES_ORG_ID=<organisation-identifier>

# CMS and autowork-worker (all secret values come from the secret manager)
DATABASE_URI=<non-loopback-postgresql-url>
PAYLOAD_SECRET=<secret-manager-value-at-least-32-characters>
PAYLOAD_PUBLIC_SERVER_URL=https://<cms-private-host>
LINKAUTOWORK_GATEWAY_URL=https://<linkautowork-private-gateway>
LINKAUTOWORK_SIGNING_SECRET=<secret-manager-value-at-least-32-characters>
LINKAUTOWORK_SIGNING_KEY_ID=<key-identifier>
LINKAUTOWORK_ENVIRONMENT=production
LINKAUTOWORK_OUTBOX_PATH=/var/lib/linksites/linkautowork-outbox.json
LINKAUTOWORK_OUTBOX_INTEGRITY_SECRET=<secret-manager-value-at-least-32-characters>
LINKAUTOWORK_EVENT_GRANTS=<non-empty-json-array-of-approved-event-org-environment-grants>

# web-master only. NEXT_PUBLIC_* values are intentionally public; never add a secret there.
NEXT_PUBLIC_CMS_PROVIDER=payload
PAYLOAD_BASE_URL=https://<cms-private-host>
NEXT_PUBLIC_PAYLOAD_API_URL=https://<cms-private-host>
PAYLOAD_API_KEY=<server-only-payload-api-key-at-least-32-characters>
PREVIEW_ACCESS_TOKEN=<secret-manager-value-at-least-32-characters>

# program-orchestrator only. This URI is a distinct least-privilege credential;
# it must never reuse the CMS DATABASE_URI. Compose maps it to DATABASE_URI only
# inside the orchestrator container because the packaged adapter reads that
# adapter-facing name. Production requires pre-provisioned tenant/site rows and
# a role that this credential may SET ROLE to.
W2_02_MODE=production
W2_02_DATABASE_URI=<distinct-non-loopback-postgresql-url-for-orchestrator>
W2_02_ORG_ID=<production-organisation-uuid>
W2_02_SITE_ID=<production-site-uuid>
W2_02_DATABASE_ROLE=svc_linksites_runtime
W2_02_APPROVED_FACTS_PATH=/var/lib/linksites/approved-facts.json
W2_02_POSTGRES_ADAPTER_MODULE=@linksites/program-orchestrator/postgres-adapter
W2_02_EXECUTION_REVISION=<same-full-40-character-git-sha-as-LINKSITES_RELEASE_SHA>
W2_02_EXECUTABLE_CHECKPOINT=<w2-02-executable-source-sha-256>
W2_02_STATE_DIR=/var/lib/linksites/program
W2_02_PAYLOAD_BASE_URL=https://<cms-private-host>
W2_02_PAYLOAD_API_KEY=<server-only-payload-api-key-at-least-32-characters>
W2_02_PAYLOAD_SITE_ID=<payload-site-identifier>
W2_02_WEB_MASTER_BASE_URL=https://<private-preview-host>
W2_02_PREVIEW_ACCESS_TOKEN=<private-preview-token-at-least-32-characters>
W2_05_OUTCOME_GATEWAY_SECRET=<secret-manager-value-at-least-32-characters>
W2_05_OUTCOME_GATEWAY_KEY_ID=<key-identifier>
W2_02_LIBRARY_REPOSITORY_PATH=/var/lib/linksites/linklibraries
# These values must be copied from the generated immutable release manifest;
# catalog and entry always name the same LiNKlibraries Git commit.
W2_02_LIBRARY_COMMIT_SHA=<same-full-40-character-linklibraries-commit>
W2_02_LIBRARY_CATALOG_SHA256=<catalog-content-sha-256-from-release-manifest>
W2_02_LIBRARY_ENTRY_SHA256=<entry-content-sha-256-from-release-manifest>

# Compose host inputs. These are interpolated before containers start and must
# be supplied as exact values by the protected Phase 2 deployment environment.
LINKSITES_RUNTIME_ENV_FILE=/absolute/path/to/protected-runtime.env
LINKSITES_CMS_IMAGE=<registry/image@sha256:digest>
LINKSITES_WEB_MASTER_IMAGE=<registry/image@sha256:digest>
LINKSITES_WORKER_IMAGE=<registry/image@sha256:digest>
LINKSITES_ORCHESTRATOR_IMAGE=<registry/image@sha256:digest>
LINKSITES_MIGRATIONS_IMAGE=<registry/image@sha256:digest>
LINKSITES_PLATFORM_MIGRATIONS_APPLIED_SHA=<full-40-character-platform-migration-sha>
LINKLIBRARIES_ARTIFACT_PATH=/absolute/path/to/approved-linklibraries-git-checkout
LINKLIBRARIES_CATALOG_SHA=<same-full-40-character-linklibraries-commit>
LINKLIBRARIES_ENTRY_SHA=<same-full-40-character-linklibraries-commit>
LINKLIBRARIES_CATALOG_CONTENT_SHA256=<catalog-content-sha-256-from-release-manifest>
LINKLIBRARIES_ENTRY_CONTENT_SHA256=<entry-content-sha-256-from-release-manifest>
TRAEFIK_NETWORK=<existing-traefik-network>
TRAEFIK_ENTRYPOINT=<existing-tls-entrypoint>
TRAEFIK_CMS_HOST=<private-cms-host>
TRAEFIK_PREVIEW_HOST=<private-preview-host>
TRAEFIK_CMS_PRIVATE_MIDDLEWARE=<existing-cms-private-middleware>
TRAEFIK_PREVIEW_PRIVATE_MIDDLEWARE=<existing-preview-private-middleware>
