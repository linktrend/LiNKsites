# This is a name-only production reference. Do not place values, credentials,
# host-specific DNS details, or private tokens in this file. Populate a
# protected runtime environment file outside Git and validate it before use.
LINKSITES_DEPLOYMENT_ENV=production
LINKSITES_CONFIG_SCHEMA_VERSION=1.0.0
LINKSITES_RELEASE_SHA=<full-40-character-git-sha>
LINKSITES_ORG_ID=<organisation-identifier>

# CMS and autowork-worker only (all secret values come from the secret manager)
DATABASE_URI=<non-loopback-postgresql-url>
PAYLOAD_SECRET=<secret-manager-value-at-least-32-characters>
PAYLOAD_PUBLIC_SERVER_URL=https://<cms-private-host>
LINKAUTOWORK_GATEWAY_URL=https://<linkautowork-private-gateway>
LINKAUTOWORK_SIGNING_SECRET=<secret-manager-value-at-least-32-characters>
LINKAUTOWORK_SIGNING_KEY_ID=<key-identifier>
LINKAUTOWORK_ENVIRONMENT=production
LINKAUTOWORK_OUTBOX_PATH=/var/lib/linksites/linkautowork-outbox.json
LINKAUTOWORK_OUTBOX_INTEGRITY_SECRET=<secret-manager-value-at-least-32-characters>
LINKAUTOWORK_EVENT_GRANTS=<non-empty-json-array-of-approved-event-org-environment-grants>

# web-master only. NEXT_PUBLIC_* values are intentionally public; never add a secret there.
NEXT_PUBLIC_CMS_PROVIDER=payload
PAYLOAD_BASE_URL=https://<cms-private-host>
NEXT_PUBLIC_PAYLOAD_API_URL=https://<cms-private-host>
PAYLOAD_API_KEY=<server-only-payload-api-key-at-least-32-characters>

# program-orchestrator only. Production requires pre-provisioned tenant/site
# rows and a database role that the supplied DATABASE_URI may SET ROLE to.
W2_02_MODE=production
W2_02_ORG_ID=<production-organisation-uuid>
W2_02_SITE_ID=<production-site-uuid>
W2_02_DATABASE_ROLE=svc_linksites_runtime
W2_02_EXECUTION_REVISION=<same-full-40-character-git-sha-as-LINKSITES_RELEASE_SHA>
W2_02_EXECUTABLE_CHECKPOINT=<w2-02-executable-source-sha-256>
W2_02_STATE_DIR=/var/lib/linksites/program
W2_02_PAYLOAD_BASE_URL=https://<cms-private-host>
W2_02_PAYLOAD_API_KEY=<server-only-payload-api-key-at-least-32-characters>
W2_02_PAYLOAD_SITE_ID=<payload-site-identifier>
W2_02_WEB_MASTER_BASE_URL=https://<private-preview-host>
W2_02_PREVIEW_ACCESS_TOKEN=<private-preview-token-at-least-32-characters>
W2_05_OUTCOME_GATEWAY_SECRET=<secret-manager-value-at-least-32-characters>
W2_05_OUTCOME_GATEWAY_KEY_ID=<key-identifier>
W2_02_LIBRARY_REPOSITORY_PATH=/var/lib/linksites/linklibraries
