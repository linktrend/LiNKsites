{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linktrend/LiNKsites/blob/issue-300-refresh-ls-02-h-09-provider-handoff-rebind-succe/docs/evidence/ls02/handoff-successor/HANDOFF.schema.json",
  "title": "LS-02 H-09/H-10 handoff successor identity contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "issue",
    "packet",
    "repository",
    "candidateParent",
    "identityOnly",
    "h09",
    "h10",
    "provider",
    "scope"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls02-handoff-successor" },
    "issue": { "const": 300 },
    "packet": { "const": "LS-02" },
    "repository": { "const": "linktrend/LiNKsites" },
    "candidateParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "identityOnly": { "const": true },
    "h09": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptAction", "conformanceAccepted"],
      "properties": {
        "receiptAction": { "const": "rebind-required" },
        "conformanceAccepted": { "const": false }
      }
    },
    "h10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewAction", "reviewAccepted"],
      "properties": {
        "reviewAction": { "const": "blocked-until-h09-rebind" },
        "reviewAccepted": { "const": false }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pinOnly", "bytesCopied"],
      "properties": {
        "repository": { "const": "linktrend/LiNKlibraries" },
        "pinOnly": { "const": true },
        "bytesCopied": { "const": false }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownedPaths", "prohibitedPaths", "claims"],
      "properties": {
        "ownedPaths": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "prohibitedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
