      "properties": {
        "candidate_materialized": { "const": "PASS" },
        "adapter_compatible": { "const": "PASS" },
        "payload_projection_valid": { "const": "PASS" },
        "server_render_valid": { "const": "PASS" },
        "browser_fixture_valid": { "const": "PASS" },
        "migration_rollback_valid": { "const": "PASS" },
        "tamper_rejected": { "const": "PASS" },
        "cache_restart_valid": { "const": "PASS" }
      }
    }
  }
}
