{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/master-v2/a1/consumer-receipt.schema.json",
  "title": "LS-08 ISS-27 consumer receipt",
  "type": "object",
  "required": [
