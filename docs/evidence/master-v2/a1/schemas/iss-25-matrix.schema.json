{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/master-v2/a1/iss-25-matrix.schema.json",
  "title": "LS-08 ISS-25 A1 fixture matrix (preparation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "layoutPack",
    "evidenceClass",
    "packetCompletion",
    "pairedProofRun",
    "slots"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls08-iss25-fixture-matrix" },
    "packetId": { "const": "LS-08" },
    "layoutPack": { "const": "a1" },
    "evidenceClass": { "type": "string", "enum": ["preparation-fixture", "schema-fixture"] },
    "packetCompletion": { "const": false },
    "pairedProofRun": { "const": false },
    "a1BytesPresent": { "const": false },
    "ls07ProtectedIntegrated": { "const": false },
    "providerA1Bound": { "const": false },
    "slots": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "planId", "scenario", "status", "pairedProofRun"],
        "properties": {
          "surface": { "enum": ["server", "browser"] },
          "planId": { "enum": ["a", "b", "c", "l"] },
          "scenario": {
            "enum": [
              "product",
              "service",
              "hybrid",
              "local",
              "resources",
              "trust",
              "failure",
              "lifecycle"
            ]
          },
          "status": { "enum": ["NOT_RUN", "HOLD"] },
          "pairedProofRun": { "const": false },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
