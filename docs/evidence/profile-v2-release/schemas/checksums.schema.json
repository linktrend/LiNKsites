{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/ls11/checksums.schema.json",
  "title": "LS-11 scaffolding checksums",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "algorithm",
    "packetId",
    "githubIssue",
    "protectedDevelopment",
    "packageDigest",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls11-release-checksums" },
    "algorithm": { "const": "sha256" },
    "packetId": { "const": "LS-11" },
    "githubIssue": { "const": 361 },
    "protectedDevelopment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "const": "02ebf5d8710c50c1f2c390989239f0baf916ba97" },
        "tree": { "const": "fb427d30ea7c3e7060fc9cc1a63a1110266dd755" }
      }
    },
    "packageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
