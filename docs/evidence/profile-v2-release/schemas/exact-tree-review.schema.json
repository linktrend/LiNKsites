{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/ls11/exact-tree-review.schema.json",
  "title": "LS-11 exact-tree review template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "githubIssue",
    "issueId",
    "evidenceClass",
    "packetCompletion",
    "reviewRun",
    "independent",
    "exactHead",
    "repairThroughOwningPackets",
    "unresolvedBlocker",
    "dimensions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls11-exact-tree-review" },
    "packetId": { "const": "LS-11" },
    "githubIssue": { "const": 361 },
    "issueId": { "const": "ISS-34" },
    "evidenceClass": { "const": "completion" },
    "packetCompletion": { "const": true },
    "reviewRun": { "const": true },
    "independent": { "const": true },
    "exactHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "tree"],
      "properties": {
        "repository": { "const": "linktrend/LiNKsites" },
        "ref": { "const": "phase/ls11-release" },
        "commit": { "const": "797acec86656984e5aba0fd36ded29237669acf7" },
        "tree": { "const": "3358c4ae4e33143799b301aa5c34f498f6a3d7ac" }
      }
    },
    "repairThroughOwningPackets": { "const": true },
    "unresolvedBlocker": { "const": false },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "architecture",
              "security",
              "tenant",
              "migration",
              "accessibility",
              "visual",
              "evidence"
            ]
          },
          "verdict": { "const": "PASS" }
        }
      }
    }
  }
}
