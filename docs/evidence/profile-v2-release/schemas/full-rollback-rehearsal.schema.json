{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/ls11/full-rollback-rehearsal.schema.json",
  "title": "LS-11 Full and rollback rehearsal template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "githubIssue",
    "issueId",
    "evidenceClass",
    "packetCompletion",
    "exactTree",
    "fullSuite",
    "rollbackRehearsal"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls11-full-rollback-rehearsal" },
    "packetId": { "const": "LS-11" },
    "githubIssue": { "const": 361 },
    "issueId": { "const": "ISS-35" },
    "evidenceClass": { "const": "scaffolding" },
    "packetCompletion": { "const": false },
    "exactTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "const": "linktrend/LiNKsites" },
        "commit": { "const": "02ebf5d8710c50c1f2c390989239f0baf916ba97" },
        "tree": { "const": "fb427d30ea7c3e7060fc9cc1a63a1110266dd755" }
      }
    },
    "fullSuite": { "$ref": "#/$defs/notRunGate" },
    "rollbackRehearsal": { "$ref": "#/$defs/notRunGate" }
  },
  "$defs": {
    "notRunGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "receiptPresent", "treeBound", "verdict"],
      "properties": {
        "run": { "const": false },
        "receiptPresent": { "const": false },
        "treeBound": { "const": false },
        "verdict": { "const": "NOT_RUN" }
      }
    }
  }
}
