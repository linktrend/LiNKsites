{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/ls11/identity.schema.json",
  "title": "LS-11 release identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "githubIssue",
    "issues",
    "repository",
    "protectedDevelopment",
    "evidenceClass",
    "packetCompletion",
    "ls11Complete",
    "productionProof",
    "hostedProof",
    "promoted",
    "futureIdentities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls11-release-identity" },
    "packetId": { "const": "LS-11" },
    "githubIssue": { "const": 361 },
    "issues": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["ISS-34", "ISS-35", "ISS-36"] }
    },
    "repository": { "const": "linktrend/LiNKsites" },
    "protectedDevelopment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "tree"],
      "properties": {
        "ref": { "const": "development" },
        "commit": { "const": "02ebf5d8710c50c1f2c390989239f0baf916ba97" },
        "tree": { "const": "fb427d30ea7c3e7060fc9cc1a63a1110266dd755" }
      }
    },
    "evidenceClass": { "const": "scaffolding" },
    "packetCompletion": { "const": false },
    "ls11Complete": { "const": false },
    "productionProof": { "const": false },
    "hostedProof": { "const": false },
    "promoted": { "const": false },
    "futureIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ls10Cutover", "harnessH09Conformance"],
      "properties": {
        "ls10Cutover": { "const": "FUTURE_LS10_CUTOVER_IDENTITY" },
        "harnessH09Conformance": { "const": "FUTURE_HARNESS_H09_CONFORMANCE_IDENTITY" }
      }
    }
  }
}
