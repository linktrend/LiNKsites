{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.local/linksites/ls11/releases-status.schema.json",
  "title": "LS-11 docs/releases status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "githubIssue",
    "releasePublished",
    "packetCompletion",
    "ls11Complete",
    "promoted",
    "founderAuthorized",
    "mainPublished",
    "productionDeployed",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ls11-releases-status" },
    "packetId": { "const": "LS-11" },
    "githubIssue": { "const": 361 },
    "releasePublished": { "const": false },
    "packetCompletion": { "const": false },
    "ls11Complete": { "const": false },
    "promoted": { "const": false },
    "founderAuthorized": { "const": false },
    "mainPublished": { "const": false },
    "productionDeployed": { "const": false },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
