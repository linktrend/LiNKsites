  "usage": {
    "description": "How to use this theme configuration",
    "canonical": "This file is the single source of truth for master-template-type-1 tokens.",
    "manual": {
      "step1": "Edit the color, typography, or other token values in the 'theme', 'darkTheme', or named industryPresets objects",
      "step2": "Regenerate projections with node scripts/v2/generate-master-template-tokens.mjs",
      "step3": "Do not hand-edit tokens.css, tokens.json, or variants.json",
      "step4": "Keep industry preset ids stable; do not add dentist here"
    },
    "aiPrompt": {
      "description": "For AI agents: edit this file, then regenerate token projections",
      "example": "To restyle from healthcare, copy values from industryPresets.healthcare into theme, then run generate-master-template-tokens.mjs"
    }
  },
  "cssVariableMapping": {
    "description": "How theme.json values map to CSS variables in tokens.css",
    "colors": {
      "primary": "--color-primary",
      "primaryForeground": "--color-primary-foreground",
      "background": "--color-background",
      "foreground": "--color-foreground",
      "muted": "--color-muted",
      "mutedForeground": "--color-muted-foreground",
      "card": "--color-card",
      "cardForeground": "--color-card-foreground",
      "border": "--color-border",
      "input": "--color-input",
      "ring": "--color-ring",
      "accent": "--color-accent",
      "accentForeground": "--color-accent-foreground"
    },
    "typography": {
      "fontFamily": "--font-family"
    },
    "spacing": {
      "xs": "--spacing-xs",
      "sm": "--spacing-sm",
      "md": "--spacing-md",
      "lg": "--spacing-lg",
      "xl": "--spacing-xl",
      "2xl": "--spacing-2xl",
      "3xl": "--spacing-3xl",
      "4xl": "--spacing-4xl",
      "5xl": "--spacing-5xl",
      "6xl": "--spacing-6xl"
    },
    "radius": {
      "sm": "--radius-sm",
      "md": "--radius-md",
      "lg": "--radius-lg"
    },
    "motion": {
      "duration": {
        "fast": "--duration-fast",
        "normal": "--duration-normal",
        "slow": "--duration-slow"
      },
      "easing": {
        "default": "--easing-default",
        "in": "--easing-in",
        "out": "--easing-out"
      }
    }
  }
