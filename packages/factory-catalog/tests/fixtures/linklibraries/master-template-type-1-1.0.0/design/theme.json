{
  "$schema": "./theme.schema.json",
  "version": "1.0.0",
  "lastUpdated": "2026-08-18",
  "description": "Master Template Theme Configuration — neighborhood-professional look for reusable SMB starter sites. Canonical source for generated tokens.",
  "theme": {
    "id": "default",
    "name": "Neighborhood Professional",
    "designSystemVersion": "v1",
    "colors": {
      "description": "Cool stone paper, pine ink, and steel accent. Not sky-on-slate and not cream-and-terracotta.",
      "background": "#eef1ef",
      "foreground": "#152018",
      "primary": "#1e5a40",
      "primaryForeground": "#f4f7f5",
      "brand": "#1e5a40",
      "brandForeground": "#f4f7f5",
      "secondary": "#3d4f47",
      "secondaryForeground": "#f4f7f5",
      "muted": "#e3e8e5",
      "mutedForeground": "#3f4d46",
      "card": "#f8faf8",
      "cardForeground": "#152018",
      "border": "#cfd7d2",
      "input": "#cfd7d2",
      "ring": "#1e5a40",
      "accent": "#2a6f97",
      "accentForeground": "#f5f9fc",
      "destructive": "#b42318",
      "destructiveForeground": "#fff7f6",
      "success": "#2f6f4e",
      "successForeground": "#f4f7f5",
      "warning": "#9a6700",
      "warningForeground": "#fffbeb",
      "info": "#2a6f97",
      "infoForeground": "#f5f9fc"
    },
    "typography": {
      "description": "One type voice. Libre Franklin for body and headings. No Inter, Roboto, Arial, or system-ui stacks.",
      "fontFamily": "'Libre Franklin', 'Source Sans 3', sans-serif",
      "fontFamilyHeading": "'Libre Franklin', 'Source Sans 3', sans-serif",
      "fontFamilyMono": "'IBM Plex Mono', 'Source Code Pro', monospace",
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem",
        "6xl": "3.75rem"
      },
      "fontWeight": {
        "light": 300,
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },
      "lineHeight": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    },
    "spacing": {
      "description": "Spacing scale - consistent padding, margin, and gap values",
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem",
      "4xl": "6rem",
      "5xl": "8rem",
      "6xl": "12rem"
    },
    "radius": {
      "description": "Modest corners for a finished office site, not a bubbly marketing landing page",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "2xl": "20px",
      "full": "9999px"
    },
    "shadows": {
      "description": "Quiet forest-ink elevation",
      "sm": "0 1px 2px 0 rgb(21 32 24 / 0.06)",
      "md": "0 6px 16px -6px rgb(21 32 24 / 0.12)",
      "lg": "0 12px 24px -8px rgb(21 32 24 / 0.14)",
      "xl": "0 20px 32px -12px rgb(21 32 24 / 0.16)",
      "2xl": "0 28px 48px -16px rgb(21 32 24 / 0.2)",
      "inner": "inset 0 1px 2px 0 rgb(21 32 24 / 0.06)"
    },
    "gradients": {
      "description": "Pine and steel washes for hero, footer, and primary surfaces",
      "primary": "linear-gradient(160deg, #1e5a40 0%, #245c52 100%)",
      "secondary": "linear-gradient(160deg, #3d4f47 0%, #152018 100%)",
      "accent": "linear-gradient(160deg, #2a6f97 0%, #1e5a40 100%)",
      "footer": "linear-gradient(160deg, #152018 0%, #1a3328 100%)",
      "hero": "linear-gradient(165deg, #152018 0%, #1e5a40 72%, #2a6f97 100%)"
    },
    "motion": {
      "description": "Animation and transition settings - timing and easing",
      "duration": {
        "instant": "0ms",
        "fast": "150ms",
        "normal": "300ms",
        "slow": "500ms",
        "slower": "700ms"
      },
      "easing": {
        "linear": "linear",
        "default": "cubic-bezier(0.4, 0, 0.2, 1)",
        "in": "cubic-bezier(0.4, 0, 1, 1)",
        "out": "cubic-bezier(0, 0, 0.2, 1)",
        "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
        "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
        "elastic": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
      }
    }
  },
  "darkTheme": {
    "id": "dark",
    "name": "Neighborhood Professional Dark",
    "designSystemVersion": "v1",
    "colors": {
      "description": "Dark theme color overrides",
      "background": "#121814",
      "foreground": "#e8eee9",
      "primary": "#7dba98",
      "primaryForeground": "#122016",
      "brand": "#7dba98",
      "brandForeground": "#122016",
      "secondary": "#9aa89f",
      "secondaryForeground": "#121814",
      "muted": "#1c2620",
      "mutedForeground": "#9aa89f",
      "card": "#1a221d",
      "cardForeground": "#e8eee9",
      "border": "#2c3932",
      "input": "#2c3932",
      "ring": "#7dba98",
      "accent": "#7eb3d1",
      "accentForeground": "#0e1a22"
    }
  },
